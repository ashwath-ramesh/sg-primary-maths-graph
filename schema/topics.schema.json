{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SG MOE Primary Mathematics Knowledge Graph — topics",
  "type": "object",
  "required": ["version", "source", "topicCount", "topics"],
  "properties": {
    "version": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["title", "publisher", "edition", "url"],
      "properties": {
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "edition": { "type": "string" },
        "url": { "type": "string" },
        "section": { "type": "string" },
        "copyright": { "type": "string" }
      }
    },
    "topicCount": { "type": "integer", "minimum": 0 },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "strand", "subStrand", "name", "sourcePage", "outcomes"],
        "properties": {
          "id": {
            "description": "<Level>.<SubStrand>.<n>, mirroring the syllabus numbering, e.g. P3.FR.1",
            "type": "string",
            "pattern": "^P[1-6]\\.(WN|MO|FR|DE|PC|RT|RA|AL|ME|AV|GE|DR|DA)\\.\\d+$"
          },
          "level": { "enum": ["P1", "P2", "P3", "P4", "P5", "P6"] },
          "strand": { "enum": ["Number and Algebra", "Measurement and Geometry", "Statistics"] },
          "subStrand": {
            "enum": ["Whole Numbers", "Money", "Fractions", "Decimals", "Percentage", "Rate", "Ratio", "Algebra",
                     "Measurement", "Area and Volume", "Geometry",
                     "Data Representation and Interpretation", "Data Analysis"]
          },
          "name": { "description": "Topic heading, verbatim from the syllabus", "type": "string" },
          "sourcePage": { "description": "Page in the syllabus PDF", "type": "integer" },
          "outcomes": {
            "description": "Learning outcomes, verbatim and in syllabus order",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "description": "<topic id>.<n>, e.g. P3.FR.1.2", "type": "string" },
                "text": { "type": "string" },
                "items": { "description": "Bullet points listed under the outcome", "type": "array", "items": { "type": "string" } },
                "note": { "description": "Parenthetical note printed under the outcome", "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
